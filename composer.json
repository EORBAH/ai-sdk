{
    "name": "eor_bah545/ai-sdk",
    "description": "SDK PHP unifié pour les fournisseurs d'IA (OpenAI, Anthropic, xAI, DeepSeek, Mistral...) : tool calling, streaming, agents, structured output, outils intégrés (recherche web, bash, éditeur de texte, exécution de code), batch, cache de prompt, fichiers.",
    "type": "library",
    "version": "0.1.0",
    "license": "MIT",
    "keywords": ["ai", "llm", "openai", "anthropic", "xai", "deepseek", "mistral", "agents", "tool calling", "streaming"],
    "authors": [{"name": "EORBAH", "email": "eor.bah545@example.com"}],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {"EorBah545\\AI\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"EorBah545\\AI\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
